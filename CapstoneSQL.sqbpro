<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="CapstoneSQL.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1494"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="gpu_benchmarks_clean" custom_title="0" dock_id="1" table="4,20:maingpu_benchmarks_clean"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011e00ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="Brand vs MSRP">SELECT Full_Model_Name, Brand, MSRP_Price, Current_Street_Price,
       ROUND((Current_Street_Price / MSRP_Price - 1) * 100, 0) AS premium_pct
FROM hardware_data
ORDER BY premium_pct DESC;

</sql><sql name="SQL 2*">SELECT CASE WHEN Series_Generation IN (50, 90) THEN '2025-26' ELSE '2022-24' END AS generation,
       Brand, COUNT(*) AS gpus,
       ROUND(AVG((Current_Street_Price / MSRP_Price - 1) * 100), 0) AS avg_premium_pct
FROM hardware_data
GROUP BY generation, Brand
ORDER BY generation, Brand;</sql><current_tab id="0"/></tab_sql></sqlb_project>
