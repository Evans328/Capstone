SET MSRP_Price = 599 
WHERE Full_Model_Name = 'GeForce RTX 4070'</sql><sql name="SQL 2*">SELECT Full_Model_Name, MSRP_Price, Current_Street_Price,
       ROUND((Current_Street_Price / MSRP_Price - 1) * 100, 1) AS premium_pct
