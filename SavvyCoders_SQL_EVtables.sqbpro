olumn_widths><column index="1" value="87"/><column index="2" value="167"/><column index="3" value="143"/><column index="4" value="39"/><column index="5" value="71"/><column index="6" value="68"/><column index="7" value="111"/><column index="8" value="119"/><column index="9" value="300"/><column index="10" value="85"/><column index="11" value="67"/><column index="12" value="52"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="GPU_benchmarks_v7" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="300"/><column index="2" value="183"/><column index="3" value="61"/><column index="4" value="63"/><column index="5" value="60"/><column index="6" value="47"/><column index="7" value="116"/><column index="8" value="58"/><column index="9" value="95"/><column index="10" value="103"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="hardware_data" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="108"/><column index="2" value="55"/><column index="3" value="159"/><column index="4" value="113"/><column index="5" value="75"/><column index="6" value="75"/><column index="7" value="129"/><column index="8" value="63"/><column index="9" value="67"/><column index="10" value="98"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">SELECT DISTINCT Model, ModelYear, Make
FROM EVRegistry
WHERE Make = 'TESLA'
AND ModelYear &gt;= '2020'
LIMIT 10;</sql><sql name="SQL 2*">SELECT COUNT(*)
FROM EVRegistry
WHERE BaseMSRP IS NULL;</sql><sql name="SQL 3*">SELECT &quot;Electric Vehicle Type&quot;
FROM EVRegistry
ORDER BY &quot;Electric Vehicle Type&quot;;</sql><sql name="SQL 4*">SELECT *
FROM EVRegistry
WHERE ElectricVehicleType LIKE '%BEV%';</sql><sql name="SQL 5*">SELECT Make, Model, ElectricVehicleType
FROM EVRegistry
WHERE VIN LIKE '%3E1EA1J';
</sql><sql name="SQL 6*">SELECT ModelYear, Make, Model, ElectricVehicleType, ElectricRange
FROM EVRegistry
WHERE Make IN ('TESLA', 'CHEVROLET')
ORDER BY ModelYear, Make DESC;</sql><sql name="SQL 7*">SELECT stationId, COUNT(*) AS TimesUsed
FROM EVCharging
GROUP BY stationId
ORDER BY TimesUsed DESC
LIMIT 5;</sql><sql name="SQL 8*">SELECT userId,
       MIN(chargeTimeHrs) AS minTime,
       MAX(chargeTimeHrs) AS maxTime
FROM EVCharging
WHERE chargeTimeHrs &gt; 0.5
GROUP BY userId
ORDER BY minTime, maxTime;</sql><sql name="SQL 10*">SELECT Brand, Full_Model_Name, MSRP_Price, Price_per_Mark
FROM hardware_data
ORDER BY Price_per_Mark DESC</sql><current_tab id="8"/></tab_sql></sqlb_project>
